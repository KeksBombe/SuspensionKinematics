# Maintainer: Marvin <m.lohss04@gmail.com>
#
# Built by .github/workflows/release.yml, which templates pkgver from the
# project() version in CMakeLists.txt and feeds in a git-archive tarball of the
# commit being released.
pkgname=suspensionkinematics
pkgver=0.1.0
pkgrel=1
pkgdesc="Suspension kinematics tool for Bremergy - 3D viewport for STL and STEP geometry"
arch=('x86_64')
url="https://github.com/KeksBombe/SuspensionKinematics"
# MIT as well as the GPL: the Tabler icons are compiled into the binary, and
# their licence asks to travel with it. cmake --install puts every licence text
# in /usr/share/licenses/$pkgname, which is where pacman looks for the ones
# outside Arch's common set.
license=('GPL-3.0-or-later' 'MIT')
# qt6-svg: the icons are Tabler SVGs, rendered through QSvgRenderer.
depends=('qt6-base' 'qt6-svg' 'opencascade' 'hicolor-icon-theme')
makedepends=('cmake' 'ninja' 'python')
# Without this makepkg splits out a -debug package, which would show up as a
# second, confusing download on the release page.
options=('!debug')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    # Tests are on so that check() below has something to run; they need
    # python3 for the STL fixtures, which is already a makedepend.
    cmake -S "$srcdir/$pkgname-$pkgver" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DSUSPKIN_BUILD_TESTS=ON
    cmake --build build
}

check() {
    # Most suites are QTEST_APPLESS_MAIN, but test_xlsx_hardpoints is
    # QTEST_MAIN, so it builds a QGuiApplication -- which calls qFatal() when it
    # cannot reach a display, and a build chroot never has one. The offscreen
    # platform plugin is part of qt6-base and needs no server.
    QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
